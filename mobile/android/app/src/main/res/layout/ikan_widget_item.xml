<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/ikan_widget_row"
    android:minHeight="52dp">

    <ImageView
        android:id="@+id/i_bar"
        android:layout_width="5dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="#58cc02"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/i_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#f1f7fb"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/i_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#97a8b2"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/i_check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/ikan_widget_check"
        android:gravity="center"
        android:text="✓"
        android:textColor="#ffffff"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
