{
  "name": "ikan-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android (and later iOS) shell for Ikan Quests, built with Capacitor",
  "scripts": {
    "sync": "cap sync android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor '#58cc02' --iconBackgroundColorDark '#58cc02' --splashBackgroundColor '#131f24' --splashBackgroundColorDark '#131f24'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
